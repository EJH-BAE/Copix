# Copix Auth API — copy to .env and fill in

PORT=8787
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
JWT_SECRET=change-me-to-a-long-random-string

# Production example:
# APP_URL=https://ejh-bae.github.io/Copix
# API_PUBLIC_URL=https://your-api.example.com

# Email (SMTP). Resend example: smtp.resend.com / resend / re_xxx
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Copix <noreply@yourdomain.com>"

# ── OAuth ────────────────────────────────────────────────────────────
# Create apps, then paste Client ID + Secret here.
# Redirect URIs (must match exactly — also printed by: npm run check-oauth):
#   Google → {API_PUBLIC_URL}/auth/callback/google
#   GitHub → {API_PUBLIC_URL}/auth/callback/github
#   Apple  → {API_PUBLIC_URL}/auth/callback/apple
#
# Google:  https://console.cloud.google.com/apis/credentials  (OAuth client → Web)
# GitHub:  https://github.com/settings/developers             (OAuth Apps → New)
# Apple:   https://developer.apple.com/account/resources/identifiers

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
