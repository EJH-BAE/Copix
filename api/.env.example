# Copix Auth API — copy to .env and fill in

PORT=8787
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
JWT_SECRET=change-me-to-a-long-random-string

# Email (SMTP). Resend example: smtp.resend.com / resend / re_xxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="Copix <noreply@yourdomain.com>"

# OAuth — leave blank to hide that provider in the UI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional: allow the web agent to call a shared Ollama host
OLLAMA_BASE_URL=http://127.0.0.1:11434
